{
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python-Debugger: MainWindow.py",
            "type": "debugpy",
            "request": "launch",
            "program": "MainWindow.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python-Debugger: Aktuelle Datei",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python-Debugger: Aktuelle Datei mit Argumenten",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": [
                "${command:pickArgs}"
            ]
        },
        {
            "name": "Python Debugger: Python File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}"
        }
    ]
}